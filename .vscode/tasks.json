{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ECU Vue: prepare Play upload",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/android-release.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "shared", "clear": true}
    },
    {
      "label": "ECU Vue: prepare Android debugger",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/android-dev.ps1", "-Mode", "Debug"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "shared", "clear": true}
    },
    {
      "label": "ECU Vue: disconnect Android debugger",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/android-dev.ps1", "-Mode", "Stop"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "silent", "panel": "shared"}
    },
    {
      "label": "ECU Vue: Android run",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/android-dev.ps1", "-Mode", "Run"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "group": {"kind": "build", "isDefault": true},
      "presentation": {"reveal": "always", "panel": "shared", "clear": true}
    },
    {
      "label": "ECU Vue: Android logcat",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/android-dev.ps1", "-Mode", "Logcat"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    }
  ]
}
